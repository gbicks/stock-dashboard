            "object": "info",
            "field": "shortName"
          }
        },
        {
          "id": "lastPrice",
          "label": "Last",
          "api_field": "lastPrice",
          "required": true,
          "fallback": null,
          "source": {
            "object": "info",
            "field": "regularMarketPrice"
          }
        },
        {
          "id": "previousClose",
          "label": "Prev Close",
          "api_field": "previousClose",
          "required": true,
          "fallback": null,
          "source": {
            "object": "info",
            "field": "regularMarketPreviousClose"
          }
        }
      ]
    }
  }
